# Copy to .env and edit. Never commit real keys.
PROVIDER_MODE=mock
MOCK_BEHAVIOR=success
MAX_OUTPUT_TOKENS_CAP=1024
PROVIDER_TIMEOUT_SECONDS=30
# JSON map of logical alias -> provider/model
# (leave MODEL_ALIASES unset in real mode, or map an alias to provider "anthropic")
MODEL_ALIASES={"default": {"provider": "mock", "model": "mock-1"}}

# --- Real provider (Anthropic) ---
# PROVIDER_MODE=real      # default alias then maps to ANTHROPIC_DEFAULT_MODEL
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low    # low|medium|high|xhigh|max; leave empty for models without effort
# PROVIDER_MAX_RETRIES=0  # 0 or 1

# --- Limits and guardrails ---
# MAX_REQUEST_BYTES=32768
# MAX_MESSAGES=50
# MAX_MESSAGE_CHARS=8000
# PII_REDACTION_ENABLED=true
# INJECTION_CHECK_ENABLED=true
# EXTRA_INPUT_BLOCK_PATTERNS=["project\s+nightingale"]   # JSON list of regexes
# OUTPUT_CANARY=CANARY-SECRET-0000                        # synthetic secret; empty disables
# OUTPUT_BLOCK_PATTERNS=["sk-[a-z0-9]{8,}"]               # JSON list of regexes
