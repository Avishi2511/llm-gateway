# SecureLLM Gateway configuration.
# Copy to .env and edit. Never commit real keys. Lines starting with "#" are optional overrides.

# --- Required ---
# Comma-separated gateway API keys that clients send as "Authorization: Bearer <key>".
# Use long random values (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
GATEWAY_API_KEYS=change-me-key-1,change-me-key-2

# --- Provider ---
# mock = deterministic fake provider, no credentials needed (default).
# real = Anthropic. Requires ANTHROPIC_API_KEY; the "default" alias then maps to ANTHROPIC_DEFAULT_MODEL.
PROVIDER_MODE=mock
# MOCK_BEHAVIOR=success
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# PROVIDER_TIMEOUT_SECONDS=30
# PROVIDER_MAX_RETRIES=0
# MAX_OUTPUT_TOKENS_CAP=1024
# Logical alias -> provider/model. Leave unset to get a single "default" alias.
# MODEL_ALIASES={"default": {"provider": "mock", "model": "mock-1"}}
# Notes: MOCK_BEHAVIOR is success | fail | timeout | unsafe (for demos and tests).
#        ANTHROPIC_EFFORT is low|medium|high|xhigh|max; leave empty for models without effort support.
#        PROVIDER_MAX_RETRIES is 0 or 1. MAX_OUTPUT_TOKENS_CAP is a server-side ceiling on a client's max_tokens.

# --- Guardrails ---
# PII_REDACTION_ENABLED=true
# INJECTION_CHECK_ENABLED=true
# JSON lists of regexes (note the doubled backslash). OUTPUT_CANARY is a synthetic secret that must never
# be returned to a client; set it empty to disable.
# EXTRA_INPUT_BLOCK_PATTERNS=["project\\s+nightingale"]
# OUTPUT_CANARY=CANARY-SECRET-0000
# OUTPUT_BLOCK_PATTERNS=["sk-[a-z0-9]{8,}"]

# --- Limits ---
# MAX_REQUEST_BYTES=32768
# MAX_MESSAGES=50
# MAX_MESSAGE_CHARS=8000
# RATE_LIMIT_PER_MINUTE=30

# --- Persistence and cost estimate ---
# DATABASE_URL=sqlite:///./gateway.db
# PRICING_JSON={"claude-opus-5-5": {"input_per_mtok": 4.0, "output_per_mtok": 20.0}}
# LOG_LEVEL=INFO
